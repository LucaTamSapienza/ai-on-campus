# Intestazioni di sicurezza per i file statici serviti dal Worker.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  # blocco 2: il microfono solo per questa origine (lezione registrata, chiesto al clic)
  Permissions-Policy: camera=(), microphone=(self), geolocation=()
  # study plan page: il PDF nel browser compila il WebAssembly di impaginazione di react-pdf, incluso come data:, e apre un worker da blob: ('wasm-unsafe-eval' permette solo WebAssembly, non eval)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' data:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
